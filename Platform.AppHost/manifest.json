{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "sql-password": {
      "type": "parameter.v0",
      "value": "{sql-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "sql": {
      "type": "container.v0",
      "connectionString": "Server={sql.bindings.tcp.host},{sql.bindings.tcp.port};User ID=sa;Password={sql-password.value};TrustServerCertificate=true",
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "volumes": [
        {
          "name": "procurement-sql-data",
          "target": "/var/opt/mssql",
          "readOnly": false
        }
      ],
      "env": {
        "ACCEPT_EULA": "Y",
        "MSSQL_SA_PASSWORD": "{sql-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1433
        }
      }
    },
    "ProcurementBidding": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=ProcurementBidding"
    },
    "ContractorRegistry": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=ContractorRegistry"
    },
    "IdentityDb": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=IdentityDb"
    },
    "mongo": {
      "type": "container.v0",
      "connectionString": "mongodb://admin:{mongo-password.value}@{mongo.bindings.tcp.host}:{mongo.bindings.tcp.port}?authSource=admin\u0026authMechanism=SCRAM-SHA-256",
      "image": "docker.io/library/mongo:8.0",
      "volumes": [
        {
          "name": "procurement-mongo-data",
          "target": "/data/db",
          "readOnly": false
        }
      ],
      "env": {
        "MONGO_INITDB_ROOT_USERNAME": "admin",
        "MONGO_INITDB_ROOT_PASSWORD": "{mongo-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 27017
        }
      }
    },
    "RiskAssessmentDb": {
      "type": "value.v0",
      "connectionString": "mongodb://admin:{mongo-password.value}@{mongo.bindings.tcp.host}:{mongo.bindings.tcp.port}/RiskAssessmentDb?authSource=admin\u0026authMechanism=SCRAM-SHA-256"
    },
    "redis": {
      "type": "container.v0",
      "connectionString": "{redis.bindings.tcp.host}:{redis.bindings.tcp.port},password={redis-password.value}",
      "image": "docker.io/library/redis:7.4",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD --save 60 1"
      ],
      "volumes": [
        {
          "name": "procurement-redis-data",
          "target": "/data",
          "readOnly": false
        }
      ],
      "env": {
        "REDIS_PASSWORD": "{redis-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "messaging": {
      "type": "container.v0",
      "connectionString": "amqp://guest:{messaging-password.value}@{messaging.bindings.tcp.host}:{messaging.bindings.tcp.port}",
      "image": "docker.io/library/rabbitmq:4.1-management",
      "volumes": [
        {
          "name": "procurement-rabbitmq-data",
          "target": "/var/lib/rabbitmq",
          "readOnly": false
        }
      ],
      "env": {
        "RABBITMQ_DEFAULT_USER": "guest",
        "RABBITMQ_DEFAULT_PASS": "{messaging-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5672
        },
        "management": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 15672
        }
      }
    },
    "identityserver-sql": {
      "type": "container.v0",
      "connectionString": "Server={identityserver-sql.bindings.tcp.host},{identityserver-sql.bindings.tcp.port};User ID=sa;Password={sql-password.value};TrustServerCertificate=true",
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "volumes": [
        {
          "name": "identityserver-sql-data",
          "target": "/var/opt/mssql",
          "readOnly": false
        }
      ],
      "env": {
        "ACCEPT_EULA": "Y",
        "MSSQL_SA_PASSWORD": "{sql-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1433
        }
      }
    },
    "IdentityServerDb": {
      "type": "value.v0",
      "connectionString": "{identityserver-sql.connectionString};Initial Catalog=IdentityServerDb"
    },
    "keycloak-admin": {
      "type": "parameter.v0",
      "value": "{keycloak-admin.inputs.value}",
      "inputs": {
        "value": {
          "type": "string"
        }
      }
    },
    "keycloak-password": {
      "type": "parameter.v0",
      "value": "{keycloak-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true
        }
      }
    },
    "keycloak": {
      "type": "container.v0",
      "image": "quay.io/keycloak/keycloak:26.2",
      "args": [
        "start",
        "--import-realm"
      ],
      "volumes": [
        {
          "name": "platform.apphost-04e9402f01-keycloak-data",
          "target": "/opt/keycloak/data",
          "readOnly": false
        }
      ],
      "env": {
        "KC_BOOTSTRAP_ADMIN_USERNAME": "{keycloak-admin.value}",
        "KC_BOOTSTRAP_ADMIN_PASSWORD": "{keycloak-password.value}",
        "KC_HEALTH_ENABLED": "true"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8080
        },
        "management": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 9000
        }
      }
    },
    "tenders-api": {
      "type": "project.v0",
      "path": "../Services/Tenders/Tenders.Api/Tenders.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{tenders-api.bindings.http.targetPort}",
        "ConnectionStrings__ProcurementBidding": "{ProcurementBidding.connectionString}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "catalog-api": {
      "type": "project.v0",
      "path": "../Services/Catalog/Catalog.Api/Catalog.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{catalog-api.bindings.http.targetPort}",
        "ConnectionStrings__ContractorRegistry": "{ContractorRegistry.connectionString}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "risk-assessments-api": {
      "type": "project.v0",
      "path": "../Services/RiskAssessments/RiskAssessments.WebApi/RiskAssessments.WebApi.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{risk-assessments-api.bindings.http.targetPort}",
        "ConnectionStrings__RiskAssessmentDb": "{RiskAssessmentDb.connectionString}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "auth-api": {
      "type": "project.v0",
      "path": "../Services/Auth/Auth.Api/Auth.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{auth-api.bindings.http.targetPort}",
        "ConnectionStrings__IdentityDb": "{IdentityDb.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "payments-api": {
      "type": "project.v0",
      "path": "../Services/Payments/Payments.Api/Payments.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{payments-api.bindings.http.targetPort}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "identityserver": {
      "type": "project.v0",
      "path": "../Platform.IdentityServer/Platform.IdentityServer.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{identityserver.bindings.http.targetPort}",
        "ConnectionStrings__IdentityServerDb": "{IdentityServerDb.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "aggregator": {
      "type": "project.v0",
      "path": "../Platform.Aggregator/Platform.Aggregator.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{aggregator.bindings.http.targetPort}",
        "services__tenders-api__http__0": "{tenders-api.bindings.http.url}",
        "services__tenders-api__https__0": "{tenders-api.bindings.https.url}",
        "services__catalog-api__http__0": "{catalog-api.bindings.http.url}",
        "services__catalog-api__https__0": "{catalog-api.bindings.https.url}",
        "services__risk-assessments-api__http__0": "{risk-assessments-api.bindings.http.url}",
        "services__risk-assessments-api__https__0": "{risk-assessments-api.bindings.https.url}",
        "services__identityserver__http__0": "{identityserver.bindings.http.url}",
        "services__identityserver__https__0": "{identityserver.bindings.https.url}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}",
        "ConnectionStrings__redis": "{redis.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "gateway": {
      "type": "project.v0",
      "path": "../Platform.ApiGateway/Platform.ApiGateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{gateway.bindings.http.targetPort}",
        "services__tenders-api__http__0": "{tenders-api.bindings.http.url}",
        "services__tenders-api__https__0": "{tenders-api.bindings.https.url}",
        "services__catalog-api__http__0": "{catalog-api.bindings.http.url}",
        "services__catalog-api__https__0": "{catalog-api.bindings.https.url}",
        "services__risk-assessments-api__http__0": "{risk-assessments-api.bindings.http.url}",
        "services__risk-assessments-api__https__0": "{risk-assessments-api.bindings.https.url}",
        "services__aggregator__http__0": "{aggregator.bindings.http.url}",
        "services__aggregator__https__0": "{aggregator.bindings.https.url}",
        "services__auth-api__http__0": "{auth-api.bindings.http.url}",
        "services__auth-api__https__0": "{auth-api.bindings.https.url}",
        "services__payments-api__http__0": "{payments-api.bindings.http.url}",
        "services__payments-api__https__0": "{payments-api.bindings.https.url}",
        "services__keycloak__http__0": "{keycloak.bindings.http.url}",
        "services__keycloak__management__0": "{keycloak.bindings.management.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "mongo-password": {
      "type": "parameter.v0",
      "value": "{mongo-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "redis-password": {
      "type": "parameter.v0",
      "value": "{redis-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "messaging-password": {
      "type": "parameter.v0",
      "value": "{messaging-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    }
  }
}