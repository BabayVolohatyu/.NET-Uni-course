{
  "ConnectionStrings": {
    "ProcurementBidding": "Server=localhost,1433;Database=ProcurementBidding;User Id=SA;Password=YourStrong!Passw0rd;TrustServerCertificate=True;Application Name=Tenders.Api",
    "messaging": "amqp://guest:guest@localhost:5672"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Jwt": {
    "Issuer": "procurement-auth",
    "Audience": "procurement-platform",
    "SecretKey": "ProcurementRiskPlatform-Dev-Jwt-Secret-Key-32b!"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5100",
    "Audience": "orders_api"
  },
  "AllowedHosts": "*"
}
