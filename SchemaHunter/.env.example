# ─────────────────────────────────────────────────────────────────────────────
# SchemaHunter — environment configuration template
#
# Copy this file to .env and fill in your local values.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env  (PowerShell)
#
# .env is git-ignored. .env.example IS committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ────────────────────────────────────────────────────────────────
# SA (system admin) password — must be 8+ chars with upper, lower, digit, symbol
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Host port for SQL Server (default 1433; change if already taken)
MSSQL_PORT=1433

# Database names created by the init scripts
MSSQL_PROCUREMENT_DB=SchemaHunterProcurement
MSSQL_REGISTRY_DB=SchemaHunterRegistry

# ADO.NET / Dapper connection string used by the Procurement service
PROCUREMENT_CONNECTION_STRING=Server=localhost,1433;Database=SchemaHunterProcurement;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# EF Core connection string used by the InfrastructureRegistry service
REGISTRY_CONNECTION_STRING=Server=localhost,1433;Database=SchemaHunterRegistry;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Root (admin) credentials — used by the init container
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=mongoSecret123

# Host port for MongoDB (default 27017)
MONGO_PORT=27017

# Database name used by the CommunityAudits service
MONGO_AUDITS_DB=SchemaHunterAudits

# Full connection string used by the CommunityAudits service
MONGO_CONNECTION_STRING=mongodb://admin:mongoSecret123@localhost:27017

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Root password for the MySQL server
MYSQL_ROOT_PASSWORD=mysqlSecret123

# Database created automatically on first start
MYSQL_DATABASE=SchemaHunterMysql

# Host port for MySQL (default 3306)
MYSQL_PORT=3306
