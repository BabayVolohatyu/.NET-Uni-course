<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP reverse proxy -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- YARP + Aspire service discovery integration -->
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="9.3.0" />
    <PackageReference Include="Aspire.Keycloak.Authentication" Version="9.3.1-preview.1.25305.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceDefaults: Serilog, OTel, CorrelationId, health checks, resilience -->
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
