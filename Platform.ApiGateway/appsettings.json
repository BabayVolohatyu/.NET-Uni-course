{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Order": 1,
        "Match": { "Path": "/auth/{**catch-all}" },
        "Metadata": { "Team": "auth", "Version": "v1" }
      },
      "users": {
        "ClusterId": "auth",
        "Order": 1,
        "Match": { "Path": "/users/{**catch-all}" },
        "Metadata": { "Team": "auth", "Version": "v1" }
      },
      "orders": {
        "ClusterId": "tenders",
        "Order": 5,
        "Match": { "Path": "/orders/{**catch-all}" },
        "Metadata": { "Team": "tenders", "Version": "v1" }
      },
      "products": {
        "ClusterId": "catalog",
        "Order": 5,
        "Match": { "Path": "/products/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "payments": {
        "ClusterId": "payments",
        "Order": 5,
        "Match": { "Path": "/payments/{**catch-all}" },
        "Metadata": { "Team": "payments", "Version": "v1" }
      },
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        }
      },
      "tenders": {
        "ClusterId": "tenders",
        "Order": 10,
        "Match": {
          "Path": "/api/tenders/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "tenders",
          "Version": "v1"
        }
      },
      "contractors": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": {
          "Path": "/api/contractors/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "risk-assessments": {
        "ClusterId": "risk-assessments",
        "Order": 10,
        "Match": {
          "Path": "/api/risk-assessments/{**catch-all}"
        },
        "Metadata": {
          "Team": "risk-assessments",
          "Version": "v1"
        }
      },
      "work-categories": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": {
          "Path": "/api/work-categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "procuring-entities": {
        "ClusterId": "tenders",
        "Order": 10,
        "Match": {
          "Path": "/api/procuring-entities/{**catch-all}"
        },
        "Metadata": {
          "Team": "tenders",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "auth": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "d1": { "Address": "http://auth-api" }
        }
      },
      "payments": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "d1": { "Address": "http://payments-api" }
        }
      },
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:60"
        },
        "Destinations": {
          "d1": { "Address": "http://aggregator" }
        }
      },
      "tenders": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": { "Address": "http://tenders-api" }
        }
      },
      "catalog": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "d1": { "Address": "http://catalog-api" }
        }
      },
      "risk-assessments": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": { "Address": "http://risk-assessments-api" }
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "procurement-auth",
    "Audience": "procurement-platform",
    "SecretKey": "ProcurementRiskPlatform-Dev-Jwt-Secret-Key-32b!"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5100",
    "Audience": "orders_api"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
